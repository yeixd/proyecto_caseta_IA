# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - SISTEMA INTELIGENTE DE CONTROL DE PEAJE
# Copiar este archivo a .env y completar con valores reales.
# NUNCA subir el archivo .env al repositorio Git.
# ==============================================================================

# --- Entorno general ---
APP_ENV=production
APP_URL=https://peaje.tudominio.com
FRONTEND_URL=https://peaje.tudominio.com
CORS_ORIGINS=https://peaje.tudominio.com

# --- Base de datos (PostgreSQL en producción o SQLite para pruebas) ---
DATABASE_URL=postgresql://peaje_user:CAMBIAR_PASSWORD_SEGURO@db:5432/peaje_db
POSTGRES_USER=peaje_user
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURO
POSTGRES_DB=peaje_db

# --- Autenticación con Google OAuth 2.0 ---
# Crear en Google Cloud Console -> APIs y servicios -> Credenciales
GOOGLE_CLIENT_ID=TU_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=TU_GOOGLE_ANDROID_CLIENT_ID.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=TU_GOOGLE_IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TU_GOOGLE_CLIENT_SECRET

# --- JWT de sesión interna del sistema ---
JWT_SECRET_KEY=GENERAR_CON_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Dominio institucional y lista blanca inicial ---
# Nota: doc.alvaro.pinto.ma@unifranz.edu.bo se agrega automáticamente como administrador
ALLOWED_EMAIL_DOMAIN=unifranz.edu.bo
EXTRA_ADMIN_EMAILS=integrante1@unifranz.edu.bo,integrante2@unifranz.edu.bo
EXTRA_OPERATOR_EMAILS=operador1@unifranz.edu.bo

# --- Endpoint único de inferencia (RunPod o Google Colab) ---
# Cambiar entre RunPod y Colab consiste únicamente en actualizar esta variable
INFERENCE_URL=https://TU-POD-ID-8000.proxy.runpod.net
INFERENCE_API_KEY=GENERAR_TOKEN_INTERNO_INFERENCIA
INFERENCE_TIMEOUT_SECONDS=20

# --- Agente Conversacional: Ollama en RunPod (LLM propio sin API externa) ---
# Si OLLAMA_URL se deja vacío o no responde, el agente usa el motor determinista sobre BD
OLLAMA_URL=https://TU-POD-ID-11434.proxy.runpod.net
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=25

# --- Almacenamiento de imágenes de evidencia ---
EVIDENCE_DIR=/app/uploads/evidencias
EVIDENCE_PUBLIC_BASE_URL=https://peaje.tudominio.com/static/evidencias

# --- Hardware de alertas (ESP32) ---
HARDWARE_API_KEY=GENERAR_TOKEN_ESP32_SEGURO

# --- Frontend Vite (compilación) ---
VITE_API_BASE_URL=https://peaje.tudominio.com
VITE_WS_BASE_URL=wss://peaje.tudominio.com
VITE_GOOGLE_CLIENT_ID=TU_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# --- Entrenamiento Roboflow (solo en Colab, no subir API Key) ---
ROBOFLOW_API_KEY=TU_ROBOFLOW_API_KEY
ROBOFLOW_WORKSPACE=tu-workspace-roboflow

# --- Rutas de modelos en servidor de inferencia (/inferencia) ---
MODEL_M1_PLATES_PATH=/workspace/models/m1_placas.pt
MODEL_M2_VEHICLE_SEG_PATH=/workspace/models/m2_vehiculos_seg.pt
MODEL_M3_WHEEL_POSE_PATH=/workspace/models/m3_ruedas_pose.pt
MODEL_M4_PASSENGERS_SEG_PATH=/workspace/models/m4_pasajeros_seg.pt
OCR_ENGINE=easyocr
OCR_GPU=true
